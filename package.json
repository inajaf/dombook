{
  "name": "dombook-desktop",
  "version": "0.2.0",
  "description": "Local desktop booking system for vacation houses and cottages",
  "main": "src/main.cjs",
  "author": {
    "name": "DomBook",
    "email": "inajaf@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.cjs",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:linux": "electron-builder --linux --x64 --publish never",
    "build:web": "node scripts/build-web.cjs"
  },
  "dependencies": {
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.dombook.desktop",
    "productName": "DomBook",
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "files": [
      "src/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/dombook.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/dombook-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "DomBook-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DomBook-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Office",
      "icon": "build/dombook-icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "artifactName": "DomBook-${version}-${os}-${arch}.${ext}"
  }
}
