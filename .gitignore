node_modules/
dist/
release/
coverage/
*.log
.DS_Store
data/
backups/

# Local environment and secrets. Nothing here may be committed; the server takes its
# DSN, JWT_SECRET and ADMIN_API_KEY from the environment (see server/README.md).
.env
.env.*
!.env.example

# Generated analysis output (graphify). Machine-specific absolute paths; not source.
graphify-out/

# Vision toolkit artifacts (crops, traces, diffs, screenshots) written by the DSH
# `vision_*` tools. They land in the session workspace, so without this rule every
# vision call shows up as untracked noise in `git status`.
.dsh-vision-toolkit/
